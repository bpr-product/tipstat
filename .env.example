# Copy to .env (never commit .env - it is git-ignored) and paste the key we give you at kickoff.
# This key is for your SYSTEM's runtime model calls only - not for your coding assistant.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=paste-the-key-from-kickoff-here
MODEL=deepseek/deepseek-v4.1-flash

# Only for the optional local LLM judge (--judge llm) and local gateway (harness.proxy):
# OPENROUTER_API_KEY=paste-your-key-here
# JUDGE_MODEL=z-ai/glm-5.3
