# PROVIDED BY THE ORGANIZERS - do not edit this file.
# Your dependencies go in requirements.txt, system packages in apt-packages.txt
# (one per line), and extra services (Qdrant, Postgres, ...) in compose.extra.yml.
# The eval checks this file is unmodified.
FROM python:3.12-slim
WORKDIR /app

COPY requirements.txt ./
COPY apt-packages.tx[t] ./
RUN if [ -f apt-packages.txt ]; then \
        pkgs=$(sed -e 's/#.*//' apt-packages.txt | tr '\n' ' '); \
        if [ -n "$(echo $pkgs | tr -d ' ')" ]; then \
            apt-get update && \
            apt-get install -y --no-install-recommends $pkgs && \
            rm -rf /var/lib/apt/lists/*; \
        fi; \
    fi
RUN pip install --no-cache-dir -r requirements.txt
# Optional and yours: build.sh runs ONCE here, at image build time, WITH internet. Download and
# save embedding / reranker models (or any other assets) in it. At runtime the container is offline.
COPY build.s[h] ./
RUN if [ -f build.sh ]; then sh build.sh; fi

COPY . .
ENV PORT=8000
EXPOSE 8000
CMD ["python", "server.py"]
